{
  "name": "dsh-workspace-envrc",
  "version": "0.1.0",
  "description": "Out-of-tree DSH bundle: applies the local machine's native direnv environment to explicitly Agent/workspace-owned Bash executions and local stdio workspace MCP rows. Depends on dsh-workspace-overlay; requires a host-installed direnv; never calls allow/deny or reads .envrc itself.",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "direnv",
    "workspace",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TTTPOB/dsh-workspace-envrc.git"
  },
  "homepage": "https://github.com/TTTPOB/dsh-workspace-envrc#readme",
  "bugs": {
    "url": "https://github.com/TTTPOB/dsh-workspace-envrc/issues"
  },
  "type": "module",
  "main": "./dist/provider.js",
  "exports": {
    ".": {
      "types": "./dist/provider.d.ts",
      "default": "./dist/provider.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./bash-adapter": {
      "types": "./dist/bash-adapter.d.ts",
      "default": "./dist/bash-adapter.js"
    },
    "./integration-plugin": {
      "types": "./dist/integration-plugin.d.ts",
      "default": "./dist/integration-plugin.js"
    },
    "./mcp-adapter": {
      "types": "./dist/mcp-adapter.d.ts",
      "default": "./dist/mcp-adapter.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dist",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && vitest run"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-shell": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-timeout": "^0.1.0-rc.6",
    "dsh-workspace-overlay": "^0.1.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-jobs": "0.1.0-rc.6",
    "@deepseek-ai/dsh-jobs-local": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.6",
    "@deepseek-ai/dsh-shell": "0.1.0-rc.6",
    "@deepseek-ai/dsh-shell-env": "0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.6",
    "@deepseek-ai/dsh-timeout": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tool-bash": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "dsh-workspace-overlay": "file:../dsh-workspace-overlay",
    "js-yaml": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "license": "MIT"
}
