{
  "name": "dsh-workspace-envrc",
  "version": "0.1.0",
  "description": "Out-of-tree DSH bundle: applies the local machine's native direnv environment to explicitly Agent/workspace-owned Bash executions and persistent terminals. Block A: package skeleton and provider core (Config, activation preflight, Agent->workspace resolution, direnv exec argv/command wrappers, managed DSH_* restoration shim); the reversible Bash/terminal adapters land in later blocks.",
  "type": "module",
  "main": "./dist/provider.js",
  "exports": {
    ".": {
      "types": "./dist/provider.d.ts",
      "default": "./dist/provider.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dist",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-timeout": "^0.1.0-rc.6",
    "dsh-workspace-overlay": "^0.1.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.6",
    "@deepseek-ai/dsh-timeout": "0.1.0-rc.6",
    "@types/node": "^24.0.0",
    "dsh-workspace-overlay": "file:../dsh-workspace-overlay",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "license": "MIT"
}
